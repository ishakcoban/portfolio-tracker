// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model Portfolio {
  id                  Int                     @id @default(autoincrement())
  name                String                  @unique
  totalInvestedByUSD  Float                   @default(0)
  totalInvestedByEURO Float                   @default(0)
  totalInvestedByTRY  Float                   @default(0)
  assets              Asset[]
  dailyChanges        PortfolioDailyChange[]
  yearlyChanges       PortfolioYearlyChange[]
}

model PortfolioDailyChange {
  id          Int       @id @default(autoincrement())
  open        Float
  high        Float
  low         Float
  close       Float
  time        String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId Int
}

model PortfolioYearlyChange {
  id               Int       @id @default(autoincrement())
  investedByUSD    Float
  investedByEURO   Float
  investedByTRY    Float
  finalValueByUSD  Float
  finalValueByEURO Float
  finalValueByTRY  Float
  roiByUSD         Float
  roiByEURO        Float
  roiByTRY         Float
  year             Int
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId      Int
}

model Asset {
  id                       Int           @id @default(autoincrement())
  symbol                   String        @unique
  type                     AssetType
  totalInvestedByUSD  Float         @default(0)
  totalInvestedByEURO Float         @default(0)
  totalInvestedByTRY  Float         @default(0)
  totalQuantity            Float         @default(0)
  averageCostByUSD         Float         @default(0)
  averageCostByEURO        Float         @default(0)
  averageCostByTRY         Float         @default(0)
  initialWeight            Float
  portfolio                Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId              Int
  transactions             Transaction[]
}

model Transaction {
  id       Int             @id @default(autoincrement())
  type     TransactionType
  price    Float
  quantity Float
  usdtry   Float
  eurusd   Float
  invested Float
  date     DateTime
  asset    Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId  Int?
}

enum AssetStatus {
  ACTIVE
  PASSIVE
}

enum TransactionType {
  BUY
  SELL
}

enum AssetType {
  ETF
  INDEX
  STOCK
  COMMODITY
  BOND
  CRYPTO
}

enum CurrencyType {
  USD
  EURO
  TRY
}
