// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model Portfolio {
  id                       Int                    @id @default(autoincrement())
  name                     String                 @unique
  totalRawInvestmentByUSD  Float                  @default(0)
  totalRawInvestmentByEURO Float                  @default(0)
  totalRawInvestmentByTRY  Float                  @default(0)
  assets                   Asset[]
  dailyChanges             PortfolioDailyChange[]
}

model PortfolioDailyChange {
  id          Int       @id @default(autoincrement())
  open        Float
  high        Float
  low         Float
  close       Float
  time        String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  portfolioId Int
}

model Asset {
  id                       Int           @id @default(autoincrement())
  symbol                   String        @unique
  type                     AssetType
  imageUrl                 String
  isActive                 AssetStatus   @default(ACTIVE)
  totalRawInvestmentByUSD  Float         @default(0)
  totalRawInvestmentByEURO Float         @default(0)
  totalRawInvestmentByTRY  Float         @default(0)
  totalQuantity            Float         @default(0)
  averageCostByUSD         Float         @default(0)
  averageCostByEURO        Float         @default(0)
  averageCostByTRY         Float         @default(0)
  initialWeight            Float
  portfolio                Portfolio     @relation(fields: [portfolioId], references: [id])
  portfolioId              Int
  transactions             Transaction[]
}

model Transaction {
  id         Int             @id @default(autoincrement())
  type       TransactionType
  price      Float
  quantity   Float
  usdtry     Float
  eurusd     Float
  investment Float
  date       DateTime
  asset      Asset?          @relation(fields: [assetId], references: [id])
  assetId    Int?
}

enum AssetStatus {
  ACTIVE
  PASSIVE
}

enum TransactionType {
  BUY
  SELL
}

enum AssetType {
  ETF
  INDEX
  STOCK
  COMMODITY
  BOND
  CRYPTO
}

enum CurrencyType {
  USD
  EURO
  TRY
}
